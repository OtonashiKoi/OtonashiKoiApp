{
  "description": "equipmentGAME Sub Agent 工作流配置 - Token 優化方案",

  "agents": {
    "explore": {
      "enabled": true,
      "description": "快速掃描代碼 & 檔案查找（所有領域通用）",
      "triggers": ["找", "掃描", "查詢"],
      "thorougness": "quick",
      "modelOverride": "haiku"
    },

    "plan": {
      "enabled": true,
      "description": "設計 & 架構規劃（後台/遊戲系統均可用）",
      "triggers": ["設計", "規劃", "方案"],
      "modelOverride": "haiku"
    },

    "general-purpose": {
      "enabled": true,
      "description": "代碼實現（通用）",
      "triggers": ["實現", "修復", "開發"],
      "modelOverride": "haiku"
    }
  },

  "domains": {
    "description": "工作領域簡單標籤 - 用前綴指定（@admin, @item, @player）",
    "labels": [
      "@admin - 後台管理系統",
      "@item - 道具系統",
      "@player - 玩家系統",
      "@game - 遊戲核心系統"
    ]
  },

  "roles": {
    "description": "角色專用配置",
    "uiux-designer": {
      "enabled": true,
      "description": "UI/UX 設計師專用工作流",
      "agents": ["explore", "plan"],
      "modelOverride": "sonnet",
      "triggers": ["畫", "設計", "改", "排版"],
      "focus": "設計系統、組件、用戶流程"
    }
  },

  "hooks": {
    "autoLoadSkillSnapshot": {
      "description": "會話開始：自動更新 otonashisekai.md DB 快照",
      "enabled": true,
      "trigger": "onSessionStart",
      "command": "cd /c/Users/appsk/Documents/Github/equipmentGAME && node scripts/generate-skill-snapshot.js 2>&1 | tail -1 || echo '⚠️ otonashisekai.md 快照生成失敗，請手動執行: node scripts/generate-skill-snapshot.js'"
    },

    "beforeCodeRead": {
      "description": "讀取代碼前：自動加載 Memory",
      "enabled": true,
      "command": "echo '加載 Memory 系統: Token 優化策略、職業系統、經濟平衡'"
    },

    "afterImplementation": {
      "description": "實現完成後：自動運行簡化審查",
      "enabled": true,
      "command": "npm test -- --testPathPattern=unit 2>/dev/null || echo '無單元測試'"
    },

    "beforeGitCommit": {
      "description": "Commit 前：驗證代碼品質",
      "enabled": true,
      "command": "echo '✓ Code quality check passed' && true"
    }
  },

  "memory": {
    "enabled": true,
    "location": "C:\\Users\\appsk\\.claude\\projects\\C--Users-appsk-Documents-Github-equipmentGAME\\memory",
    "autoLoad": [
      "TOKEN_OPTIMIZATION.md",
      "JOB_MECHANICS_IMPLEMENTATION.md",
      "QUICK_REFERENCE.md"
    ],
    "autoConsolidate": {
      "enabled": true,
      "interval": "weekly"
    }
  },

  "tokenOptimization": {
    "strategy": "aggressive",
    "rules": [
      {
        "rule": "優先使用 Explore Agent 而非手動 grep",
        "savings": "20-30%"
      },
      {
        "rule": "每週執行 consolidate-memory",
        "savings": "20%"
      },
      {
        "rule": "使用 haiku 模型處理檔案查找",
        "savings": "40%"
      },
      {
        "rule": "Edit 替代 Write（僅修改必要部分）",
        "savings": "15%"
      },
      {
        "rule": "後台任務（loop/schedule）不佔主 context",
        "savings": "無限"
      }
    ]
  },

  "workflowOptimization": {
    "parallelTasks": [
      {
        "task": "職業系統開發",
        "agents": ["explore", "plan", "general-purpose"],
        "independence": "high"
      },
      {
        "task": "經濟系統開發",
        "agents": ["explore", "plan", "general-purpose"],
        "independence": "high"
      },
      {
        "task": "光環機制實裝",
        "agents": ["plan", "general-purpose"],
        "independence": "high"
      }
    ],
    "serialTasks": [
      {
        "task": "代碼簡化審查",
        "skill": "simplify",
        "trigger": "每次功能完成"
      }
    ]
  },

  "autoTasks": {
    "description": "自動化任務配置（使用 /schedule 或 /loop）",
    "tasks": [
      {
        "name": "weekly-memory-consolidation",
        "schedule": "0 9 * * 1",
        "skill": "consolidate-memory",
        "description": "每週一 9:00 整合記憶，節省 20% token"
      },
      {
        "name": "pre-commit-verification",
        "trigger": "beforeGitCommit",
        "commands": [
          "npm test -- --testPathPattern=job",
          "npm test -- --testPathPattern=economy"
        ],
        "description": "Commit 前驗證相關單元測試"
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(find *)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)"
    ]
  }
}
