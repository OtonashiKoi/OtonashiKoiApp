      "Bash(findstr /r /s \"參戰\" src\\\\*.js)",
      "Bash(findstr /s /r \"參戰\\\\|notifyKill\\\\|DM\\\\|user.send\" src\\\\*.js src\\\\bot\\\\*.js src\\\\api\\\\routes\\\\*.js)",
      "Bash(mongosh mongodb://localhost:27017/equipmentgame --quiet --eval ' *)",
      "Bash(grep -n \"itemRepository\" src/bootstrap.js)",
      "Bash(grep -rn \"itemRepository\" src/index.js)",
      "Bash(node --check src/shared/effectEngine.js)",
      "Bash(node --check src/bot/handlers/monsterZoneHandlers.js)",
      "Bash(node --check src/api/routes/playerAppRoutes.js)",
      "Bash(node --check src/services/shop/shopService.js)",
      "Read(//c/Users/appsk/.pm2/logs/**)",
      "Read(//root/.pm2/**)",
      "Bash(tasklist)",
      "Read(//c/Users/appsk/.pm2/pids/**)",
      "Bash(node --env-file=.env -e ' *)",
      "Bash(node -e \"require\\('./src/shared/combatLoop.js'\\); console.log\\('OK'\\);\")",
      "Bash(node -c /c/Users/appsk/Documents/Github/equipmentGAME/src/bot/handlers/monsterZoneHandlers.js)",
      "Bash(node scripts/migrate-gem-stacking.js)",
      "Bash(node -e \"require\\('./src/services/auction/auctionRepository.js'\\); console.log\\('auctionRepository OK'\\)\")",
      "Bash(node -e \"require\\('./src/services/auction/auctionService.js'\\); console.log\\('auctionService OK'\\)\")",
      "Bash(node -e \"require\\('./src/bot/handlers/auctionZoneHandlers.js'\\); console.log\\('auctionZoneHandlers OK'\\)\")",
      "Bash(node -e \"require\\('./src/services/createServiceContext.js'\\); console.log\\('createServiceContext OK'\\)\")",
      "Bash(node -e \"require\\('./src/bot/handlers/auctionZoneHandlers.js'\\); console.log\\('OK'\\)\")",
      "Bash(node -e \"require\\('./src/bot/commands.js'\\); console.log\\('OK'\\)\")",
      "Bash(node scripts/fix-all-enhance-gear.js)"
    ]
  },
  "description": "equipmentGAME Sub Agent 工作流配置 - Token 優化方案",
  "agents": {
    "explore": {
      "enabled": true,
      "description": "快速掃描代碼 & 檔案查找（所有領域通用）",
      "triggers": [
        "找",
        "掃描",
        "查詢"
      ],
      "thorougness": "quick",
      "modelOverride": "haiku"
    },
    "plan": {
      "enabled": true,
      "description": "設計 & 架構規劃（後台/遊戲系統均可用）",
      "triggers": [
        "設計",
        "規劃",
        "方案"
      ],
      "modelOverride": "haiku"
    },
    "general-purpose": {
      "enabled": true,
      "description": "代碼實現（通用）",
      "triggers": [
        "實現",
        "修復",
        "開發"
      ],
      "modelOverride": "haiku"
    }
  },
  "domains": {
    "description": "工作領域簡單標籤 - 用前綴指定（@admin, @item, @player）",
    "labels": [
      "@admin - 後台管理系統",
      "@item - 道具系統",
      "@player - 玩家系統",
      "@game - 遊戲核心系統"
    ]
  },
  "roles": {
    "description": "角色專用配置",
    "uiux-designer": {
      "enabled": true,
      "description": "UI/UX 設計師專用工作流",
      "agents": [
        "explore",
        "plan"
      ],
      "modelOverride": "sonnet",
      "triggers": [
        "畫",
        "設計",
        "改",
        "排版"
      ],
      "focus": "設計系統、組件、用戶流程"
    }
  },
  "memory": {
    "enabled": true,
    "location": "C:\\Users\\appsk\\.claude\\projects\\C--Users-appsk-Documents-Github-equipmentGAME\\memory",
    "autoLoad": [
      "TOKEN_OPTIMIZATION.md",
      "JOB_MECHANICS_IMPLEMENTATION.md",
      "QUICK_REFERENCE.md"
    ],
    "autoConsolidate": {
      "enabled": true,
      "interval": "weekly"
    }
  },
  "tokenOptimization": {
    "strategy": "aggressive",
    "rules": [
      {
        "rule": "優先使用 Explore Agent 而非手動 grep",
        "savings": "20-30%"
      },
      {
        "rule": "每週執行 consolidate-memory",
        "savings": "20%"
      },
      {
        "rule": "使用 haiku 模型處理檔案查找",
        "savings": "40%"
      },
      {
        "rule": "Edit 替代 Write（僅修改必要部分）",
        "savings": "15%"
      },
      {
        "rule": "後台任務（loop/schedule）不佔主 context",
        "savings": "無限"
      }
    ]
  },
  "workflowOptimization": {
    "parallelTasks": [
      {
        "task": "職業系統開發",
        "agents": [
          "explore",
          "plan",
          "general-purpose"
        ],
        "independence": "high"
      },
      {
        "task": "經濟系統開發",
        "agents": [
          "explore",
          "plan",
          "general-purpose"
        ],
        "independence": "high"
      },
      {
        "task": "光環機制實裝",
        "agents": [
          "plan",
          "general-purpose"
        ],
        "independence": "high"
      }
    ],
    "serialTasks": [
      {
        "task": "代碼簡化審查",
        "skill": "simplify",
        "trigger": "每次功能完成"
      }
    ]
  },
  "autoTasks": {
    "description": "自動化任務配置（使用 /schedule 或 /loop）",
    "tasks": [
      {
        "name": "weekly-memory-consolidation",
        "schedule": "0 9 * * 1",
        "skill": "consolidate-memory",
        "description": "每週一 9:00 整合記憶，節省 20% token"
      },
      {
        "name": "pre-commit-verification",
        "trigger": "beforeGitCommit",
        "commands": [
          "npm test -- --testPathPattern=job",
          "npm test -- --testPathPattern=economy"
        ],
        "description": "Commit 前驗證相關單元測試"
      }
    ]
  }
}
