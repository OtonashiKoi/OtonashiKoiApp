{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "lib"
  ]
}
