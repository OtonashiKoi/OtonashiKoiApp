# Discord Bot Settings
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Admin & Permissions
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
PERSONAL_ROOM_CHANNEL_ID=
ADMIN_PASSWORD=
DISABLE_WELCOME_AUDIT=0
WELCOME_AUDIT_INTERVAL_MS=1800000

# API Settings
API_PORT=5566
JWT_SECRET=super-secret-jwt-key
# 對外公開網址（Cloudflare Tunnel / 正式網域）
PUBLIC_BASE_URL=https://your-public-domain.example

# Cloudflare Workers 綁定 API
STREAM_BINDING_API_BASE_URL=https://your-workers-subdomain.workers.dev
STREAM_BINDING_API_TOKEN=change-me

# Storage Settings
# Use 'mongo' for cloud DB or 'json' for local file
STORAGE_DRIVER=mongo
MONGODB_URI=
MONGODB_DB_NAME=equipment_game
JSON_DATA_PATH=./data/game.json

# OneComme Settings (for Cloud-to-Home Tunneling)
# Example API: https://your-tunnel.ngrok-free.app
# Example WS:  ws://your-tunnel.ngrok-free.app/sub
ONECOMME_API_URL=
ONECOMME_WS_URL=

# CORS 白名單（逗號分隔，填你的 GitHub Pages 網址）
# 例：ALLOWED_ORIGINS=https://otonashikoiapp.github.io
ALLOWED_ORIGINS=

# Cloudinary 圖片雲端儲存（https://cloudinary.com 免費註冊取得）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
