DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
PLAYER_ROLE_IDS=
PLAYER_USER_IDS=
API_PORT=5566
# 儲存驅動：json（本地檔案）或 mongo（MongoDB）
STORAGE_DRIVER=json
JSON_DATA_PATH=./data/game.json
# MongoDB 設定（STORAGE_DRIVER=mongo 時必填）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=equipment_game
ADMIN_PASSWORD=admin123

# Discord OAuth2 (Web App 登入使用)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
JWT_SECRET=super-secret-jwt-key
